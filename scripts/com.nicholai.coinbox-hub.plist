<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.nicholai.coinbox-hub</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/coinbox</string>
    <string>sync-serve</string>
    <string>--db</string><string>__HOME__/coinbox-hub/coinbox.sqlite</string>
    <string>--tokens</string><string>__HOME__/.config/coinbox/sync-tokens.json</string>
    <string>--port</string><string>8791</string>
__SIMPLEFIN__  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__HOME__/coinbox-hub/hub.log</string>
  <key>StandardErrorPath</key><string>__HOME__/coinbox-hub/hub.log</string>
</dict>
</plist>
