# Copy to .env (gitignored) and fill in. Read by scripts/generate-project.sh and scripts/deploy-hub.sh.

# Apple Developer team ID, needed only for iOS device builds.
DEVELOPMENT_TEAM=
# ssh host of the server that runs the sync hub, used by scripts/deploy-hub.sh.
HUB_HOST=

# The variables below are not read from .env; export them in your shell when you need them.
# Database file for the CLI, the MCP server and the Mac app (default ~/Library/Application Support/Coinbox/coinbox.sqlite).
# COINBOX_DB=/tmp/coinbox-demo.sqlite
# YNAB personal access token, for `coinbox import-ynab` and `coinbox ynab-compare`.
# YNAB_TOKEN=your-ynab-token
# Anthropic API key, for `coinbox ai-categorize --api` (or put it in ~/.config/coinbox/anthropic_key, mode 600).
# ANTHROPIC_API_KEY=your-anthropic-key
# MCP server only: path to the coinbox binary (default: coinbox on PATH, then ~/.local/bin/coinbox).
# COINBOX_BIN=/path/to/coinbox
# MCP server only: set to 0 to skip the background `coinbox sync` around tool calls.
# COINBOX_AUTOSYNC=1
